generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Source {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  url       String
  homepage  String?
  type      String    // "rss" | "scrape" | "api"
  lang      String    // "en" | "zh"
  weight    Float     @default(1.0)
  category  String    // "research" | "industry" | "opensource" | "media"
  enabled   Boolean   @default(true)
  lastFetch DateTime?
  articles  Article[]

  // ===== fetch health (maintained by apps/fetcher) =====
  // consecutiveFails reaching SOURCE_FAIL_THRESHOLD flips enabled=false so a
  // dead feed stops burning cycles; re-enable manually via Prisma Studio.
  consecutiveFails Int       @default(0)
  lastError        String?
  lastErrorAt      DateTime?

  @@index([category, enabled])
}

model Article {
  id          Int      @id @default(autoincrement())
  sourceId    Int
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  url         String   @unique
  urlHash     String   @unique
  title       String
  titleHash   String
  summary     String?
  author      String?
  publishedAt DateTime
  fetchedAt   DateTime @default(now())
  lang        String
  category    String
  tags        String[] @default([])
  score       Float    @default(0)
  signals     Json?    // e.g. { comments: 120, stars: 340 } — cross-source merges keep the max per key
  raw         Json?
  // Reposts of the same story folded into this canonical row (cross-source
  // title-hash / url dedupe): [{ source, url, publishedAt }]
  crossPosts  Json?

  // ===== AI enrichment (filled by background analyzer) =====
  aiSummaryEn   String?   // 1-2 sentence English summary
  aiSummaryZh   String?   // 1-2 sentence Chinese summary
  aiTopics      String[]  @default([]) // 3-5 normalized topic tags
  aiSentiment   String?   // "release" | "research" | "opinion" | "rumor" | "tutorial" | "other"
  aiImportance  Float?    // 0-1, model's standalone importance estimate
  aiAnalyzedAt  DateTime?
  aiModel       String?   // model id used, e.g. "claude-haiku-4-5"
  // Retryable enrichment state. aiAnalyzedAt is set only after success;
  // transient provider/parser failures use retry + exponential backoff.
  aiStatus        String    @default("pending") // pending | processing | retry | success | failed
  aiAttempts      Int       @default(0)
  aiNextAttemptAt DateTime?
  aiLastError     String?
  aiLeaseUntil    DateTime?
  aiPromptVersion String?

  @@index([score(sort: Desc), publishedAt(sort: Desc)])
  @@index([category, score(sort: Desc)])
  @@index([sourceId, publishedAt(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
  @@index([titleHash])
  @@index([aiAnalyzedAt])
  @@index([aiStatus, aiNextAttemptAt, score(sort: Desc)])
  @@index([aiLeaseUntil])
  @@index([aiTopics(ops: ArrayOps)], type: Gin)
}

model Digest {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique // truncated to UTC day
  lang        String   @default("en") // generated as a bilingual record but split for index by lang/date
  headline    String   // single-line "story of the day"
  overview    String   // 3-5 sentence prose
  bullets     Json     // [{ title, takeaway, urls: [..] }]
  themes      String[] @default([])
  model       String?
  createdAt   DateTime @default(now())

  @@index([date(sort: Desc)])
}

// Answer cache for the public /api/ask endpoint. Same question (normalized,
// hashed) within the TTL is served from here instead of hitting the LLM.
// Written by apps/web; stale rows are purged by the fetcher's retention pass.
// This is a request cache, not user state — no identity attached.
model AskCache {
  id        Int      @id @default(autoincrement())
  hash      String   @unique // sha1(question.trim().toLowerCase())
  question  String
  answer    String
  model     String?
  hits      Int      @default(1)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Durable cost/concurrency valve for the anonymous /api/ask endpoint. The
// daily row stores settled usage; short-lived reservations make concurrent
// web processes account for in-flight calls before they spend provider tokens.
model AskDailyUsage {
  day          DateTime         @id @db.Date
  usedTokens   Int              @default(0)
  updatedAt    DateTime         @updatedAt
  reservations AskReservation[]
}

model AskReservation {
  id             String        @id @default(uuid())
  day            DateTime      @db.Date
  dailyUsage     AskDailyUsage @relation(fields: [day], references: [day], onDelete: Cascade)
  reservedTokens Int
  expiresAt      DateTime
  createdAt      DateTime      @default(now())

  @@index([day, expiresAt])
  @@index([expiresAt])
}

// Cross-process leases for singleton jobs. Acquisition is serialized with a
// PostgreSQL advisory transaction lock; the durable expiry lets another
// process recover safely after a worker crash without holding an idle database
// transaction for the whole network-heavy job.
model CoordinationLease {
  name           String   @id
  ownerId        String
  leaseUntil     DateTime
  heartbeatAt    DateTime
  startedAt      DateTime
  attempts       Int      @default(1)
  lastFinishedAt DateTime?
  lastStatus     String   @default("running") // running | success | failed
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([leaseUntil])
  @@index([lastStatus, leaseUntil])
}

// Shared fixed-window counters for public, cost-bearing fetch endpoints.
// keyHash is a SHA-256 digest of the limiter namespace and normalized client
// address; raw client IPs are never persisted.
model RateLimitBucket {
  name      String
  keyHash   String
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([name, keyHash])
  @@index([resetAt])
  @@index([name, resetAt])
}

// Curated directory of high-quality AI researcher / practitioner blogs
// (Lil's Log, colah's blog, …). Permanent editorial list — NOT subject to
// the 14-day Article retention purge. Seeded via packages/db/src/seed.ts;
// no user submissions, no accounts.
model CuratedBlog {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String   // "Lil's Log"
  author      String   // "Lilian Weng"
  url         String   // homepage
  feedUrl     String?  // optional RSS/Atom
  affiliation String?  // "OpenAI" | "Independent" | lab/company
  bioEn       String
  bioZh       String
  tags        String[] @default([]) // focus areas: interpretability, llm, systems…
  lang        String   @default("en") // primary writing language
  featured    Boolean  @default(false)
  sortOrder   Int      @default(100) // lower = higher on the list
  enabled     Boolean  @default(true)

  // ===== 食用指南 / reading guide (editorial, bilingual) =====
  // How often posts land, how to approach the archive, era map, and
  // "start here" pieces. Seeded only — not LLM-generated.
  guideCadenceEn  String? // "1–2 long surveys / year"
  guideCadenceZh  String?
  guideHowEn      String? // how to read / subscribe / skim
  guideHowZh      String?
  guideTimelineEn String? // content eras over the years
  guideTimelineZh String?
  // [{ title, url?, noteEn?, noteZh? }] — recommended entry points
  guideStartHere  Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, sortOrder])
  @@index([featured, sortOrder])
  @@index([tags(ops: ArrayOps)], type: Gin)
}
